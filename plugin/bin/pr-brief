#!/bin/sh
# pr-brief: runs the binary for this machine.
#
# The binaries are not in git. The release workflow builds them. This launcher uses, in order:
#   1. $PR_BRIEF_BIN, to run a different binary (for development);
#   2. a binary next to this script, which ./build.sh puts there;
#   3. the release binary for this plugin's version, downloaded once, checked against the
#      release's SHA256SUMS, and kept in the cache.
set -eu

if [ -n "${PR_BRIEF_BIN:-}" ]; then
  exec "$PR_BRIEF_BIN" "$@"
fi

here="$(cd "$(dirname "$0")" && pwd)"
ext=""

case "$(uname -s)" in
  Darwin) os=darwin ;;
  Linux) os=linux ;;
  MINGW*|MSYS*|CYGWIN*) os=windows; ext=.exe ;;
  *) echo "pr-brief: unsupported OS $(uname -s)" >&2; exit 1 ;;
esac

case "$(uname -m)" in
  arm64|aarch64) arch=arm64 ;;
  x86_64|amd64) arch=amd64 ;;
  *) echo "pr-brief: unsupported architecture $(uname -m)" >&2; exit 1 ;;
esac

name="pr-brief-$os-$arch$ext"

if [ -x "$here/$name" ]; then
  exec "$here/$name" "$@"
fi

manifest="$here/../.claude-plugin/plugin.json"
version="$(sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$manifest" 2>/dev/null | head -1)"
if [ -z "$version" ]; then
  echo "pr-brief: no binary at $here/$name and no version in $manifest. Run ./build.sh, or download a release from https://github.com/gagoar/pr-brief/releases" >&2
  exit 1
fi

cache="${PR_BRIEF_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/pr-brief}/v$version"
if [ ! -x "$cache/$name" ]; then
  url="https://github.com/gagoar/pr-brief/releases/download/v$version"
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT
  if ! curl -fsSL -o "$tmp/$name" "$url/$name" || ! curl -fsSL -o "$tmp/SHA256SUMS" "$url/SHA256SUMS"; then
    echo "pr-brief: cannot download v$version from $url" >&2
    echo "  A merge to main publishes the release a few minutes later; try again soon, or run ./build.sh." >&2
    exit 1
  fi
  want="$(awk -v n="$name" '$2 == n { print $1 }' "$tmp/SHA256SUMS")"
  if command -v sha256sum >/dev/null 2>&1; then
    have="$(sha256sum "$tmp/$name" | awk '{ print $1 }')"
  else
    have="$(shasum -a 256 "$tmp/$name" | awk '{ print $1 }')"
  fi
  if [ -z "$want" ] || [ "$want" != "$have" ]; then
    echo "pr-brief: the downloaded $name does not match SHA256SUMS; not running it" >&2
    exit 1
  fi
  chmod +x "$tmp/$name"
  mkdir -p "$cache"
  mv "$tmp/$name" "$cache/$name"
fi

exec "$cache/$name" "$@"
